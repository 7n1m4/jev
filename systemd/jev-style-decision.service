[Unit]
Description=Jev-Style-0.8B-Decision-v3 -- local CPU-only decision service (oh-my-pi typesafe judge)
Documentation=file:%h/.local/share/jev-local/README.md
# The service is a local decision scorer for the coding agent's judge role. It is
# started after the filesystem is writable and the session is up.
#
# Deliberately NOT After/Wants=network-online.target: everything it needs is on
# this box -- a GGUF in ~/.local/share/jev-local/assets and a locally built
# scorer -- so it never dials out, and ordering after network-online would let a
# slow DHCP hold up a start that has no network dependency at all.
After=local-fs.target default.target
Wants=local-fs.target

# ---- Start limit (the crash-loop brake) -------------------------------------
# These are per-unit settings and therefore belong to [Unit], not [Service]:
# systemd ignores them in [Service] silently (systemd-analyze verify warns), so
# putting them here is the placement that actually takes effect.
#
# systemd's default is burst=5 within interval=10s. That is too tight here
# because this unit's only realistic failure mode is a preflight that fails
# deterministically (model missing, sha256 mismatch, scorer binary missing --
# all in service.py, all a broken install rather than a transient), and
# rapidly retrying a deterministic failure is pure noise. Ruled out by source
# inspection:
#   * the preflight is NOT a slow startup: its only real work is one sha256 over
#     the 505 MiB GGUF plus one scorer probe. Measured live on this box, cold
#     start to a listening socket is seconds, not minutes.
#   * so the interval does not need to be long to accommodate slow starts; it is
#     long so that the restart ladder below (10s + 20s + 40s + 80s = 150s of
#     accumulated delay) can actually complete before the limit trips, giving
#     the install 5 real attempts instead of being cut off mid-ladder.
#
# 300s / burst 5, derived from this unit's own restart ladder:
#   * one bad start costs 10s + 20s + 40s + 80s = 150s of delay before the 5th
#     attempt, so the interval must be > 150s or the default 10s interval would
#     kill the unit after its first failure and no ladder would ever be walked;
#   * 300s is 2x that ladder, which leaves the whole ladder plus a slow start
#     inside one window.
# After the 5th failure the unit enters failed state and STAYS there until a
# human, a timer or a reboot resets it. That is the point: the box stops
# churning and the operator's attention is the intended recovery path.
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple

# Written as %h (systemd's "the user's home directory") rather than
# /home/vi/...: the unit is committed to a public repo, install.sh clones into
# ~/.local/share/jev-local, and %h expands at runtime to the invoking user's
# home, so the same file works for any user on any machine. systemd-analyze
# verify accepts %h in WorkingDirectory/ExecStart (verified against systemd 262
# on this machine), and install.sh's systemctl enable --now call is what makes
# the expansion happen against a real, existing path.
#
# The working directory is set even though the service resolves every path
# itself (HERE/REPO_ROOT are derived from __file__ in service.py, and the model,
# scorer binary and readout_config are all repo-relative with env overrides).
# It is set so any incidental relative-path write, or a cwd-relative crash/core
# dump, lands in the repo instead of in /.
#
# JEV_LOCAL_DIR is pinned HERE, as an Environment= default, rather than being
# written literally into ExecStart below. That is what makes the unit relocatable
# without a drop-in: systemd expands ${JEV_LOCAL_DIR} in ExecStart against the
# environment it has assembled at that point, so this Environment= line supplies
# the default and an operator can replace the whole path with one line -- either
# in the EnvironmentFile below or in `systemctl --user edit`:
#   [Service]
#   Environment=JEV_LOCAL_DIR=/some/other/checkout
# Note that this is the one place a shell-style ${VAR} is relied on; it is safe
# only because the variable is always defined above. If it were not, systemd
# would refuse to start the unit at all, logging
# "Referenced but unset environment variable evaluates to an empty string".
Environment=JEV_LOCAL_DIR=%h/.local/share/jev-local
WorkingDirectory=%h/.local/share/jev-local

# ---- ExecStart ---------------------------------------------------------------
# run.sh is the repo's own entry point: it cds into service/ and execs
# `python3 service.py "$@"`, so the service keeps its documented startup contract
# (including forwarding arguments) instead of the unit re-implementing it.
#
# The trap this avoids: `python3 <path>/run.sh` is NOT equivalent -- run.sh is a
# /bin/sh script, so python3 would try to parse it and die with a SyntaxError on
# line 8 ("cd \"$(dirname \"$0\")\""). Verified live against systemd 262: that
# exact form failed with "Main process exited, code=exited, status=1/FAILURE"
# and a python traceback in the journal. The script is executed, not interpreted.
#
# JEV_WORKERS=1 and JEV_PORT=61021 are set explicitly on the env command line
# rather than left to the code's defaults (2 and 61021):
#   * JEV_WORKERS=1 -- each worker is a separate scorer *subprocess* holding its
#     own copy of the model's runtime state, and service/README.md measured
#     ~1.2 GiB peak RSS per scorer process on this box. The service's throughput
#     bound is not concurrency: it is one thread of matrix multiply per request
#     (service/README.md measures a single request at 139 ms), and the judge role
#     sends one decision at a time, rarely. Extra workers buy contention and
#     memory, not latency. MemoryMax is deliberately not set (below), so pinning
#     one scorer here is the only place the footprint is bounded.
#   * JEV_PORT=61021 -- stated so a silent default change upstream cannot move
#     the service off the port the extension and every curl example depend on.
#     It matches DEFAULT_PORT in service.py, and the port is chosen above the
#     box's ephemeral range (comment below).
#
# These are passed via /usr/bin/env on the command line rather than with
# Environment=, and that is deliberate: systemd applies Environment= vars in
# unit-file order, and an EnvironmentFile= appearing LATER in the file overrides
# an Environment= that came before it (verified empirically on this machine with
# systemd 262: a probe unit with Environment=FLAG_REPO=x followed by
# EnvironmentFile=-...env yielded FLAG_REPO=y from the file). Passing the values
# on the env command line makes them win regardless, so the override contract
# documented under "Path / model overrides" is honest: JEV_GGUF and JEV_SCORER_DIR
# are meant to be overridden, JEV_WORKERS/JEV_PORT are pinned.
#
# The unit does NOT set JEV_GGUF: the model lives in the repo's assets/ and
# service.py's default resolution finds it. The documented override is the
# EnvironmentFile below.
ExecStart=/usr/bin/env JEV_WORKERS=1 JEV_PORT=61021 ${JEV_LOCAL_DIR}/service/run.sh

# ---- Path / model overrides -------------------------------------------------
# Optional, absent by default (the leading '-' makes a missing file a non-error,
# so the unit runs identically on a machine that never creates it).
#
# Use it for the two paths that legitimately differ per machine: where the 505
# MiB GGUF is, and where the scorer binary is. Everything else is repo-relative.
#
# Create it as ~/.config/jev-local/env, in KEY=VALUE form, one per line:
#   JEV_GGUF=/home/you/.cache/huggingface/.../Jev-Style-0.8B-Decision-v3-Q4_K_M.gguf
#   JEV_SCORER_DIR=/home/you/.local/share/jev-local/scorer
#
# NOTE on precedence, since it is a real sharp edge: systemd applies Environment=
# and EnvironmentFile= in unit-file order, and later assignments win. The
# Environment=JEV_LOCAL_DIR=... default above therefore applies, and a
# JEV_LOCAL_DIR line in the EnvironmentFile below would REPLACE it -- which is
# the supported way to relocate the service to another checkout:
#   JEV_LOCAL_DIR=/some/other/checkout
# JEV_WORKERS/JEV_PORT are NOT overridable from that file: they are passed on the
# env command line, whose values beat any EnvironmentFile assignment. That is
# deliberate (see the ExecStart comment) and keeps the unit's one-worker memory
# contract intact.
EnvironmentFile=-%h/.config/jev-local/env

# ---- Restart policy ----------------------------------------------------------
# on-failure, NOT always:
#   * always would also restart a clean exit 0, and an exit 0 after a start is
#     not distinguishable from "the work finished", so it would turn an operator
#     stop into a restart loop.
#   * on-failure covers exactly what this service can hit: the preflight's
#     SystemExit(2) with a precise reason (model missing, sha256 mismatch,
#     readout_config missing/wrong format, scorer binary missing, scorer probe
#     failure -- all in service.py), a crash in the scorer pool, and the OOM
#     killer. Preflight failures are the common case and they are the reason
#     this value is needed at all.
#   * on-abnormal is not enough: it would miss the preflight's clean exit 2.
Restart=on-failure
# Graduated backoff. A flat RestartSec=5 would let a hard-down service churn the
# box at 12 attempts/minute forever; this linear ramp (10s, 20s, 40s, 80s, then
# held at 80s) means the 5 attempts cost ~150s in total delay, so something
# genuinely broken takes ~30x longer to heat the machine up and reaches the
# start limit quietly. The ramp starts at 10s rather than 5s because the
# service's own startup already includes a live scorer probe, i.e. seconds of
# work before the port binds, and restarting sooner than that can only overlap
# the previous attempt's own shutdown.
RestartSec=10s
RestartSteps=5
RestartMaxDelaySec=80s

# ---- Stop timeout ------------------------------------------------------------
# The service holds no open device handle, but it does hold scorer *subprocesses*
# on a JSON-lines stdin/stdout protocol (service/pool.py), and uvicorn waits for
# in-flight requests before its shutdown hook runs. systemd's 90s default is
# left explicit here rather than raised: nothing in this service is measured to
# need more, and the fastapi/uvicorn versions on this machine shut down
# cleanly, so bounding it explicitly rather than inheriting a default keeps the
# unit's behaviour pinned to a documented value.
TimeoutStopSec=90s

# ---- Logging -----------------------------------------------------------------
# journal is the only sink. Nothing is written to disk by the unit, so there is
# no rotation to manage, and journald's own rate limiting protects the disk from
# a crash-looping service.
#
# Both streams to the journal, interleaved, is what makes the preflight legible:
# preflight() prints its per-check lines to stdout with explicit flush and its
# FATAL line to stderr, so `journalctl --user -u jev-style-decision` answers
# "what is broken?" -- including the sha256 mismatch case, which is exactly the
# message an operator needs.
#
# PYTHONUNBUFFERED=1 so the preflight's flushed prints (and any traceback) are
# not lost in a full buffer during a crash-loop, and so the ordering between
# the service's own prints and uvicorn's access log is preserved.
StandardOutput=journal
StandardError=journal
SyslogLevel=info
Environment=PYTHONUNBUFFERED=1

# ---- Memory ------------------------------------------------------------------
# THE COMMITTED FILE CARRIES NO MemoryMax LINE. This is deliberate and it is not
# an oversight: a ceiling is only as good as the measurement behind it, and a
# number measured on one box with one model path and one worker count is exactly
# what a public repo must not hard-code for everybody else's machine.
#
# The operator who wants one gets it GENERATED AT INSTALL TIME instead:
# install.sh measures the installed tree's cgroup after start-up and writes a
#   MemoryMax=<computed>
# line into the installed copy, so the number is measured on the machine that
# will enforce it. The committed file stays portable; the installed file carries
# the measurement. That keeps the repo as the source of truth for everything
# except the one value that genuinely cannot be known before the first run.
#
# ── Why it cannot be an EnvironmentFile knob ──────────────────────────────────
# Tried and disproved on systemd 262 with a throwaway probe unit:
#     MemoryMax=${JEV_MEMORY_MAX}
#     EnvironmentFile=-...env   # containing JEV_MEMORY_MAX=1600M
# systemd-analyze verify reports
#     Invalid memory limit '${JEV_MEMORY_MAX}', ignoring
# and `systemctl --user show -p MemoryMax` returns infinity. Unlike ExecStart,
# size-parsing directives do NOT get variable expansion -- they are parsed
# before the environment is applied, and an unparseable value is silently
# dropped rather than failing the unit. So MemoryMax must be substituted into
# the file text, which is what install.sh does. (ExecStart's ${JEV_LOCAL_DIR}
# DOES work -- verified live -- because command lines are expanded later.)
#
# ── The measurement install.sh replays, and the recipe ────────────────────────
# Taken on this box (7800X3D, systemd 262, 1 worker), in the unit's OWN cgroup:
#
#   PROCESS counters (ps / /proc/<pid>/status):
#     python3 service.py   VmRSS  199-375 MiB   VmHWM  265-402 MiB
#     jev-gguf-scores      VmRSS 1164-1205 MiB  VmHWM 1205-1236 MiB
#     sum of VmHWM                              ~1470-1638 MiB
#     smaps_rollup on the scorer: Pss 1201, Anonymous 702, Private_Clean 498 MiB
#
#   CGROUP counters (what MemoryMax is enforced against — the only ones that count):
#     memory.current / memory.peak   1117 MiB
#     memory.stat: anon 969.4 / file 0.0 / kernel 72.8 / slab 0.3 MiB
#     (969.4 + 0.0 + 72.8 = 1042.2, matching memory.current to the rounding)
#     memory.events: high=0 max=0 oom=0 oom_kill=0, unchanged after 8
#     concurrent 3-question requests
#
# The two disagree, and the direction is the whole lesson: the cgroup number is
# ~500 MiB BELOW the VmHWM sum. ps RSS/VmRSS is a *process* counter over one
# PID's page tables; VmHWM still counts pages since reclaimed or swapped out.
# cgroup memory.current is anon + file + kernel, decomposed exactly by
# memory.stat, and is the only thing MemoryMax sees. Here the scorer's 498 MiB
# of Private_Clean pages (the tail of the 505 MiB GGUF, read in and never
# written) are precisely the pages the kernel drops and re-faults first under
# pressure. So:
#   * sizing off ps numbers (VmHWM sum) is ~1.5x too loose;
#   * sizing off memory.peak alone ignores the ~73 MiB kernel charge (kernel
#     stacks, page tables, slab) that ps cannot see at all — and that is also
#     where zswap-compressed pages land on a box with swap (this one has
#     zpool/zstd and swappiness=100).
# The arithmetic that produced the 1664 MiB on this box:
#     memory.peak observed                       1117 MiB
#   + kernel/ps-invisible charge allowance         73 MiB
#   + file-cache pages coming back under pressure 474 MiB
#                                                        --------
#                                                        1664 MiB
# ~10.6% of this machine's 15.7 GB, so the protective intent stands: it bounds a
# runaway (a second worker, a scoring loop, a request storm) but cannot fire on a
# healthy daemon. An unattended service killed into a start-limit-hit loop by an
# over-tight limit has availability zero, which is a far worse failure than a
# slightly larger ceiling. The bound that actually matters is JEV_WORKERS=1
# above, which caps the scorer side at one such process.
#
# Recompute on another box with:
#     systemctl --user show jev-style-decision -p MemoryPeak -p MemoryCurrent
#     cat /sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service\
# /app.slice/jev-style-decision.service/memory.stat
# (read memory.peak's value in bytes, size the ceiling off it, not off ps RSS).
#
# No MemoryMin, and that is a decision rather than an omission: this is bounding,
# not reserving. A protected floor would bias the kernel into keeping this
# cgroup's pages resident under pressure and away from the desktop, which is the
# opposite of what the user wants. The ceiling is the whole mechanism.
OOMPolicy=stop
# OOMPolicy applies when a limit exists: kill the service and restart it into a
# clean state, rather than throttling it into a latency disaster. For a decision
# service "throttled" means every judge request timing out instead of failing
# fast and visibly. With no MemoryMax in the committed file it has no effect
# until install.sh adds one, and is stated so the policy is explicit rather than
# left to whatever default a future systemd picks.

# ---- CPU-only guarantee (from the repo's own contract) -----------------------
# This unit sets no device variable and passes no backend flag, because the
# scorer cannot use a GPU:
#   * the scorer hard-sets mp.n_gpu_layers = 0 (scorer/src/jev_scores.cpp), so it
#     cannot offload even if asked to;
#   * the shared libllama it links was configured with -DGGML_CUDA=OFF
#     -DGGML_HIP=OFF -DGGML_VULKAN=OFF -DGGML_SYCL=OFF -DGGML_MUSA=OFF
#     -DGGML_METAL=OFF, and build.sh fails the build if the binary links a GPU
#     library or carries a GPU symbol;
#   * so no CUDA_VISIBLE_DEVICES or equivalent is needed -- there is nothing
#     here that could see a GPU. This box's card is a gaming GPU and is
#     untouched by this service.
# This also means the ProtectHome=read-only + ReadWritePaths=~/.cache/nvidia
# dance that a Vulkan/GPU unit needs (keeping the driver's pipeline cache
# writable or paying a full shader recompile per restart) is NOT applicable here
# and is deliberately not copied.

# ---- Other hardening ---------------------------------------------------------
# NoNewPrivileges: the service has no reason to gain privileges; it reads a
# world-readable model, runs a locally built binary, and binds a high port
# (unprivileged, >1024) on loopback.
NoNewPrivileges=yes

# KillMode=mixed: SIGTERM first, so uvicorn's shutdown path runs and the pool's
# scorer subprocesses are asked to quit cleanly over their JSON-lines protocol
# (`{"cmd":"quit"}`), rather than being SIGKILLed mid-line and leaving a socket
# or a half-written stream behind. The rest of the cgroup follows.
KillMode=mixed

# ProtectHome: read-only for $HOME. The reasoning, and why this is safe here
# even though the model and repo also live under $HOME:
#   * the service's own reads-under-$HOME are the model in ~/.local/share/jev-local/
#     assets/ and the repo's python sources -- both read-only by nature, and
#     ProtectHome=read-only permits reads;
#   * the GPU-pipeline-cache rationale that forces ReadWritePaths under a Vulkan
#     unit does not apply: this service links no GPU library and spawns no
#     driver loader, so the nvidia shader cache fd's a Vulkan service keeps open
#     simply do not exist here;
#   * so unlike the GPU case, a read-only $HOME costs nothing and still stops an
#     accidental write from a future code change from clobbering the user's files.
ProtectHome=read-only

# PrivateTmp=yes. What it costs and buys here, stated honestly rather than
# inherited:
#   * neither the service nor the scorer writes to /tmp (no tempfile use in the
#     python, and the scorer's protocol is stdin/stdout), so nothing that works
#     now can break;
#   * it also gives the service a private mount namespace, which keeps a runaway
#     request from being able to see or disturb another service's /tmp contents;
#   * and, a practical one for the judge role: a decision service that keeps its
#     own scratch space cannot be confused by stale files another user service
#     left in /tmp.
# The consequence worth knowing before debugging it: a `systemctl --user
# stop/start` cycle sees a fresh /tmp each time, so nothing can be cached there.
PrivateTmp=yes

[Install]
WantedBy=default.target
